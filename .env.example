ENVIRONMENT=development

LOG_LEVEL=INFO

APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=sqlite+aiosqlite:///./leadgen.db

REQUEST_TIMEOUT=20

# Individual search request timeout
SEARCH_REQUEST_TIMEOUT=10

# Query generation limits
MAX_SEARCH_QUERIES_PER_LOCATION=10
MAX_DORK_QUERIES_PER_LOCATION=5
MAX_INTENT_QUERIES_PER_SERVICE_PER_LOCATION=8

# Candidate / discovery limits
MAX_CANDIDATES_CHECKED_PER_JOB=500
MAX_SEARCH_QUERIES_PER_JOB=200

# Website discovery
MAX_WEBSITE_DOMAINS_PER_JOB=100
WEBSITE_CRAWL_TIMEOUT=20
CRAWL_CONCURRENCY=5
MAX_CRAWL_DEPTH=2

# Source execution
SOURCE_TIMEOUT=60

# Target lead generation
DEFAULT_TARGET_LEADS=20

# Safety
MAX_RUNTIME_MINUTES=15

USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36 LeadDiscoveryEngine/1.0